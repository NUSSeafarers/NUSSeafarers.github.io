---
// src/components/BlogSection.astro
interface Props {
  title: string;
  href: string;
  description: string;
}

const { title, href, description } = Astro.props;
---

<a
  href={href}
  class="block group transition hover:bg-blue-50 rounded-xl px-6 py-8"
>
  <div
    class="flex flex-col md:flex-row md:items-start md:justify-between gap-6"
  >
    <h3
      class="text-2xl font-medium text-neutral-900 min-w-[8rem] group-hover:underline"
    >
      {title}
    </h3>
    <p
      class="text-xl leading-[1.75rem] h-[3.5rem] /* mobile: 2 lines */
    md:text-2xl md:leading-[2rem] md:h-[4rem]
    font-normal text-neutral-700 max-w-2xl overflow-hidden
    [display:-webkit-box] [-webkit-line-clamp:2] [-webkit-box-orient:vertical]
    group-hover:underline"
    >
      {description}
    </p>
  </div>
</a>
