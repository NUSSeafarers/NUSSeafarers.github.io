---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HeroSection from "../../../components/HeroSection.astro";
import BlogCard from "../../../components/blog/BlogCard";
import { getCollection } from 'astro:content';

const sailing = (await getCollection('sustainability')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout
  title="Sustainability | NUS Seafarers"
  description="Thoughts on conservation, climate action, and responsible exploration."
>
  <HeroSection
    title="Sustainability at sea and ashore."
    subtitle="How we’re thinking about conservation, reducing our footprint, and contributing to a more sustainable future."
    path="sustainability"
  />

	<section class="w-full px-6 sm:px-12 md:px-32 pb-24">
    <div class="text-3xl md:text-4xl lg:text-5xl pb-8">Conserving Our Environment</div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {sailing.map((post) => (
        <BlogCard
          slug={`sustainability/${post.slug}`}
          thumbnail={post.data.coverImage ?? "/fallback.jpg"}
          title={post.data.title}
          summary={post.data.description}
        />
      ))}
    </div>
  </section>
</BaseLayout>
