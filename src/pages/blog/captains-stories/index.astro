---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import HeroSection from "../../../components/HeroSection.astro";
import BlogCard from "../../../components/blog/BlogCard";
import { getCollection } from 'astro:content';

const sailing = (await getCollection('captain')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

---

<BaseLayout title="The Captain's Stories | NUS Seafarers" description="In Our Element!">
  <HeroSection
    title="The Captain's Stories."
    subtitle="Straight from the captain’s log… and sometimes his imagination."
    path="sailing"
  />

  <section class="w-full px-6 sm:px-12 md:px-32 pb-24">
    <div class="text-3xl md:text-4xl lg:text-5xl pb-8">Latest Stories from the Sea</div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {sailing.map((post) => (
        <BlogCard
          slug={`captains-stories/${post.slug}`}
          thumbnail={post.data.coverImage ?? "/fallback.jpg"}
          title={post.data.title}
          summary={post.data.description}
        />
      ))}
    </div>
  </section>
</BaseLayout>
