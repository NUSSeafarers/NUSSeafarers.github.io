---
import HeroImg from "../components/HeroImg";
import BaseLayout from "../layouts/BaseLayout.astro";
import Paragraph from "../components/text/Paragraph.astro";
import YouTubeEmbed from "../components/YouTubeEmbed.astro";
import NewsCard from "../components/news/NewsCard";
import SeafarerHistoryMap, { type VisitInput} from "../components/map/SeafarerHistoryMap";

import { getCollection } from 'astro:content';

const sustainability = await getCollection("sustainability");
const voyages = await getCollection("voyages");

type EntryWithCoords = { data: { lat?: number; lng?: number; title: string } };

function extractVisits(entries: ReadonlyArray<EntryWithCoords>): VisitInput[] {
  return entries
    .filter(({ data }) => Number.isFinite(data.lat) && Number.isFinite(data.lng))
    .map(({ data }) => ({ lat: data.lat, lng: data.lng, title: data.title }));
}

const sustainabilityVisits = extractVisits(sustainability);
const voyageVisits = extractVisits(voyages);

// Merge into one array
const visits: VisitInput[] = [...sustainabilityVisits, ...voyageVisits];
---

<BaseLayout
  title="Home | NUS Seafarers"
  description="Welcome to the NUS Seafarers homepage."
>
  <HeroImg
    background="/images/hero_images/moonrock_lagoon.jpg"
    title="NUS Seafarers"
    subtitle="To sail is to live."
  />

  <section class="w-full px-6 sm:px-12 md:px-32 p-20">
    <div class="text-3xl md:text-4xl lg:text-5xl pb-8">Who are we?</div>
    <Paragraph>
      The NUS Seafarers is an initiative by the{" "}
      <a
        href="https://nus.edu.sg/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-blue-700 hover:text-blue-900 hover:underline transition-colors duration-300"
      >
        National University of Singapore
      </a>
      , and has organised{" "}
      <strong>27 seafaring voyages</strong> since January 2017—spanning{" "}
      <strong>292 days at sea</strong> with{" "}
      <strong>352 total voyagers</strong> on board.
    </Paragraph>

    <Paragraph>
      These voyages offer participants unique experiences, immersing them in the
      culture, nature, economy, and maritime infrastructure of{" "}
      <strong>Malaysia, Indonesia, Thailand, and the Philippines</strong>. Along
      the way, they become veritable seafarers, guided and enriched by the
      experience and advice of the participating alumni.
    </Paragraph>

    <YouTubeEmbed videoId="xjpVuoEg3Wk" />
  </section>
  <section class="w-full px-6 sm:px-12 md:px-32 p-20">
    <div class="text-center text-3xl md:text-4xl lg:text-5xl pb-4">
      Trail of the Seafarers.
    </div>
    <div class="flex justify-center py-10">
      <SeafarerHistoryMap client:only="react" visits={visits} />
    </div>
  </section>
  <section class="w-full px-6 sm:px-12 md:px-32 p-20">
    <div class="text-center text-3xl md:text-4xl lg:text-5xl pb-8">
      The latest from NUS Seafarers
    </div>
    <div class="flex justify-center py-20">
      <NewsCard
        title="NUS Seafarers"
        imageSrc="/images/news/nusseafarers_poster1.jpg"
        href="/"
      />
    </div>
  </section>
</BaseLayout>
